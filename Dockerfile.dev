# Dockerfile.dev — development image used by docker-compose.yml (local dev
# loop) and docker-compose.test.yml (test:ci). The production `Dockerfile` is
# a hardened multi-stage build (dumb-init, USER node, no devDependencies,
# dist/ only) and cannot run migrations or Jest, which need src/ and
# devDependencies. This image trades that hardening for full source +
# devDependencies so both local dev (`npm run dev` via tsx watch, source
# bind-mounted) and CI test runs work.
#
# Not used in production. If you change the production build flow, edit
# `Dockerfile`, not this file.
FROM node:20-alpine

WORKDIR /app

COPY package*.json ./

RUN npm install

COPY . .

CMD ["npm", "run", "dev"]

{
  "info": {
    "name": "Lakira Auth Contract",
    "_postman_id": "a1dea226-auth",
    "description": "Contract happy paths for authentication endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "POST /auth/login – seeded account",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{contractUserEmail}}\",\n  \"password\": \"{{contractUserPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test(\"Token present\", function () {",
              "  pm.expect(json.data.token).to.be.a('string');",
              "});",
              "pm.environment.set('contractAuthToken', json.data.token);",
              "pm.environment.set('contractLoggedInUserId', json.data.user.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /auth/profile",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{contractAuthToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/profile",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "profile"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test(\"Profile matches logged in user\", function () {",
              "  pm.expect(json.data.id).to.eql(pm.environment.get('contractLoggedInUserId'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "PUT /auth/profile – idempotent update",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{contractAuthToken}}",
            "type": "text"
          },
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"contract_primary\",\n  \"email\": \"{{contractUserEmail}}\",\n  \"isPublicProfile\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/profile",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "profile"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test(\"User payload returned\", function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.data.user.email).to.eql(pm.environment.get('contractUserEmail'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "POST /auth/logout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{contractAuthToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/logout",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "logout"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.environment.unset('contractLoggedInUserId');"
            ]
          }
        }
      ]
    }
  ],
  "variable": [],
  "protocolProfileBehavior": {}
}

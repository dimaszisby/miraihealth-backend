{
  "info": {
    "name": "Lakira Metric Logs Contract",
    "_postman_id": "8bc7de0e-3b8c-4dc1-logs",
    "description": "Contract coverage for metric log CRUD + stats endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET /metric-logs – cursor list",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{contractAuthToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/metric-logs?limit=5&sort=-createdAt&filter[metricId]={{metricRevenueId}}",
          "host": ["{{baseUrl}}"],
          "path": ["metric-logs"],
          "query": [
            { "key": "limit", "value": "5" },
            { "key": "sort", "value": "-createdAt" },
            { "key": "filter[metricId]", "value": "{{metricRevenueId}}" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test(\"Items array present\", function () {",
              "  pm.expect(json.data.items).to.be.an(\"array\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /metric-logs – unauthorized",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/metric-logs",
          "host": ["{{baseUrl}}"],
          "path": ["metric-logs"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 401\", function () {",
              "  pm.response.to.have.status(401);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "POST /metric-logs – create log",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{contractAuthToken}}",
            "type": "text"
          },
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"metricId\": \"{{metricRevenueId}}\",\n  \"logValue\": 1234,\n  \"type\": \"manual\",\n  \"loggedAt\": \"{{$isoTimestamp}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/metric-logs",
          "host": ["{{baseUrl}}"],
          "path": ["metric-logs"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "const json = pm.response.json();",
              "pm.test(\"Metric log created\", function () {",
              "  pm.expect(json.data.metricId).to.eql(pm.environment.get('metricRevenueId'));",
              "});",
              "pm.environment.set('contractCreatedMetricLogId', json.data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "POST /metric-logs – invalid payload",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{contractAuthToken}}",
            "type": "text"
          },
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"metricId\": \"{{metricRevenueId}}\",\n  \"logValue\": 0\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/metric-logs",
          "host": ["{{baseUrl}}"],
          "path": ["metric-logs"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 400\", function () {",
              "  pm.response.to.have.status(400);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /metric-logs/:id – seeded log",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{contractAuthToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/metric-logs/{{metricLogRevenueLatestId}}?metricId={{metricRevenueId}}",
          "host": ["{{baseUrl}}"],
          "path": ["metric-logs", "{{metricLogRevenueLatestId}}"],
          "query": [{ "key": "metricId", "value": "{{metricRevenueId}}" }]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test(\"Log belongs to metric\", function () {",
              "  pm.expect(json.data.metricId).to.eql(pm.environment.get('metricRevenueId'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /metric-logs/:id – not found",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{contractAuthToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/metric-logs/00000000-0000-4000-8000-000000000077?metricId={{metricRevenueId}}",
          "host": ["{{baseUrl}}"],
          "path": ["metric-logs", "00000000-0000-4000-8000-000000000077"],
          "query": [{ "key": "metricId", "value": "{{metricRevenueId}}" }]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 404\", function () {",
              "  pm.response.to.have.status(404);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /metric-logs/stats – aggregated stats",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{contractAuthToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/metric-logs/stats?metricId={{metricRevenueId}}",
          "host": ["{{baseUrl}}"],
          "path": ["metric-logs", "stats"],
          "query": [{ "key": "metricId", "value": "{{metricRevenueId}}" }]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Stats payload exists\", function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.data).to.be.an(\"object\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "DELETE /metric-logs/:id – cleanup created log",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.environment.get('contractCreatedMetricLogId')) {",
              "  throw new Error('contractCreatedMetricLogId not set. Run create metric log first.');",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.environment.unset('contractCreatedMetricLogId');"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{contractAuthToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/metric-logs/{{contractCreatedMetricLogId}}",
          "host": ["{{baseUrl}}"],
          "path": ["metric-logs", "{{contractCreatedMetricLogId}}"]
        }
      }
    }
  ],
  "variable": [],
  "protocolProfileBehavior": {}
}

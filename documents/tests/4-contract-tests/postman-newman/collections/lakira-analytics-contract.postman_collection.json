{
  "info": {
    "name": "Lakira Analytics Contract",
    "_postman_id": "9f2f9270-d51e-4e16-94cb-analytics",
    "description": "Happy-path HTTP contract coverage for analytics dashboard + metric visualization endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET /analytics/dashboard – happy path",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{contractAuthToken}}",
            "type": "text"
          },
          { "key": "Accept", "value": "application/json", "type": "text" }
        ],
        "url": {
          "raw": "{{baseUrl}}/analytics/dashboard?last=30d&bucket=1d&tz=Asia/Jakarta",
          "host": ["{{baseUrl}}"],
          "path": ["analytics", "dashboard"],
          "query": [
            { "key": "last", "value": "30d" },
            { "key": "bucket", "value": "1d" },
            { "key": "tz", "value": "Asia/Jakarta" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test(\"Envelope shows success\", function () {",
              "  pm.expect(json.status).to.eql(\"success\");",
              "  pm.expect(json.data).to.be.an(\"object\");",
              "});",
              "pm.test(\"Dashboard items present\", function () {",
              "  pm.expect(json.data.items).to.be.an(\"array\");",
              "});",
              "pm.test(\"Dashboard schema contains category + stats\", function () {",
              "  const first = (json.data.items || [])[0];",
              "  if (!first) return pm.skip('No dashboard items to validate');",
              "  pm.expect(first).to.have.property('metricId');",
              "  pm.expect(first).to.have.property('category_name');",
              "  pm.expect(first).to.have.property('series');",
              "  pm.expect(first.series).to.be.an('array');",
              "});",
              "pm.test(\"Cache headers surfaced\", function () {",
              "  pm.expect(pm.response.headers.has('ETag')).to.be.true;",
              "  pm.expect(pm.response.headers.has('Cache-Control')).to.be.true;",
              "});",
              "pm.environment.set('analyticsDashboardEtag', pm.response.headers.get('ETag'));"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /analytics/metrics/:metricId – seeded metric",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{contractAuthToken}}",
            "type": "text"
          },
          { "key": "Accept", "value": "application/json", "type": "text" }
        ],
        "url": {
          "raw": "{{baseUrl}}/analytics/metrics/{{metricRevenueId}}?last=30d&bucket=1d&tz=Asia/Jakarta",
          "host": ["{{baseUrl}}"],
          "path": ["analytics", "metrics", "{{metricRevenueId}}"],
          "query": [
            { "key": "last", "value": "30d" },
            { "key": "bucket", "value": "1d" },
            { "key": "tz", "value": "Asia/Jakarta" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test(\"Envelope shows success\", function () {",
              "  pm.expect(json.status).to.eql(\"success\");",
              "  pm.expect(json.data).to.be.an(\"object\");",
              "});",
              "pm.test(\"MetricId matches env\", function () {",
              "  pm.expect(json.data.metricId).to.eql(pm.environment.get('metricRevenueId'));",
              "});",
              "pm.test(\"ETag header present\", function () {",
              "  pm.expect(pm.response.headers.has('ETag')).to.be.true;",
              "});",
              "pm.environment.set('analyticsMetricEtag', pm.response.headers.get('ETag'));"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /analytics/dashboard – conditional If-None-Match",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.environment.get('analyticsDashboardEtag')) {",
              "  throw new Error('analyticsDashboardEtag missing. Run the happy-path dashboard request first.');",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Returns 304\", function () {",
              "  pm.response.to.have.status(304);",
              "});",
              "pm.test(\"Body empty\", function () {",
              "  pm.expect(pm.response.text()).to.eql('');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{contractAuthToken}}",
            "type": "text"
          },
          {
            "key": "If-None-Match",
            "value": "{{analyticsDashboardEtag}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/analytics/dashboard?last=30d&bucket=1d&tz=Asia/Jakarta",
          "host": ["{{baseUrl}}"],
          "path": ["analytics", "dashboard"],
          "query": [
            { "key": "last", "value": "30d" },
            { "key": "bucket", "value": "1d" },
            { "key": "tz", "value": "Asia/Jakarta" }
          ]
        }
      }
    },
    {
      "name": "GET /analytics/dashboard – invalid bucket",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{contractAuthToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/analytics/dashboard?bucket=yearly&last=30d",
          "host": ["{{baseUrl}}"],
          "path": ["analytics", "dashboard"],
          "query": [
            { "key": "bucket", "value": "yearly" },
            { "key": "last", "value": "30d" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 400\", function () {",
              "  pm.response.to.have.status(400);",
              "});",
              "const json = pm.response.json();",
              "pm.test(\"Error envelope\", function () {",
              "  pm.expect(json.status).to.be.oneOf(['fail','error']);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /analytics/metrics/:metricId – unauthorized",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/analytics/metrics/{{metricRevenueId}}?last=30d",
          "host": ["{{baseUrl}}"],
          "path": ["analytics", "metrics", "{{metricRevenueId}}"],
          "query": [{ "key": "last", "value": "30d" }]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {

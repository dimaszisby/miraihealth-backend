            "exec": [
              "pm.test(\"Status is 401\", function () {",
              "  pm.response.to.have.status(401);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /analytics/metrics/:metricId – not found",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{contractAuthToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/analytics/metrics/00000000-0000-4000-8000-000000000099?last=30d",
          "host": ["{{baseUrl}}"],
          "path": [
            "analytics",
            "metrics",
            "00000000-0000-4000-8000-000000000099"
          ],
          "query": [{ "key": "last", "value": "30d" }]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 404\", function () {",
              "  pm.response.to.have.status(404);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}

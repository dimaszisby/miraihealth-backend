{
  "info": {
    "name": "Lakira Metric Settings Contract",
    "_postman_id": "f7e0f0a2-settings",
    "description": "Happy-path coverage for metric settings endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET /metric-settings – cursor list",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{contractAuthToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/metric-settings?limit=10&sort=-createdAt",
          "host": ["{{baseUrl}}"],
          "path": ["metric-settings"],
          "query": [
            { "key": "limit", "value": "10" },
            { "key": "sort", "value": "-createdAt" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Items array exists\", function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.data.items).to.be.an(\"array\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /metric-settings – unauthorized",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/metric-settings",
          "host": ["{{baseUrl}}"],
          "path": ["metric-settings"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 401\", function () {",
              "  pm.response.to.have.status(401);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /metric-settings/:id – seeded settings",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{contractAuthToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/metric-settings/{{metricSettingsRevenueId}}",
          "host": ["{{baseUrl}}"],
          "path": ["metric-settings", "{{metricSettingsRevenueId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test(\"settings id matches\", function () {",
              "  pm.expect(json.data.id).to.eql(pm.environment.get('metricSettingsRevenueId'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /metric-settings/:id – not found",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{contractAuthToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/metric-settings/00000000-0000-4000-8000-000000000066",
          "host": ["{{baseUrl}}"],
          "path": ["metric-settings", "00000000-0000-4000-8000-000000000066"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 404\", function () {",
              "  pm.response.to.have.status(404);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "POST /metric-settings – validation error",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{contractAuthToken}}",
            "type": "text"
          },
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"metricId\": \"{{metricRevenueId}}\",\n  \"goalEnabled\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/metric-settings",
          "host": ["{{baseUrl}}"],
          "path": ["metric-settings"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 400 (validation error)\", function () {",
              "  pm.response.to.have.status(400);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "PATCH /metric-settings/:id/display",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{contractAuthToken}}",
            "type": "text"
          },
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"displayOptions\": {\n    \"showOnDashboard\": true,\n    \"priority\": 3,\n    \"chartType\": \"bar\",\n    \"color\": \"#16A34A\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/metric-settings/{{metricSettingsProductivityId}}/display",
          "host": ["{{baseUrl}}"],
          "path": [
            "metric-settings",
            "{{metricSettingsProductivityId}}",
            "display"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test(\"Display options returned\", function () {",
              "  pm.expect(json.data).to.have.property('priority');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "PATCH /metric-settings/:id/achieve",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{contractAuthToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/metric-settings/{{metricSettingsRevenueId}}/achieve",
          "host": ["{{baseUrl}}"],
          "path": ["metric-settings", "{{metricSettingsRevenueId}}", "achieve"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Envelope success\", function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.status).to.eql('success');",
              "});"
            ]
          }
        }
      ]
    }
  ],

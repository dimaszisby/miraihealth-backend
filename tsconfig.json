{
  "extends": "@tsconfig/node18/tsconfig.json",
  "compilerOptions": {
    "target": "esnext",
    "module": "NodeNext",
    "rootDir": ".",
    "moduleResolution": "NodeNext",
    "baseUrl": "src",
    "paths": {
      "@/*": ["./*"],
      "@utils/*": ["./utils/*"],
      "@config/*": ["./config/*"],
    },
    "typeRoots": [
      "./node_modules/@types",
      "./src/types"
    ],
    "types": [
      "node",
      "jest"
    ],
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "declaration": false,
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true
  },
  "ts-node": {
    "compilerOptions": {
      "module": "NodeNext"
    }
  },
  "include": [
    "*.ts",
    "src/**/*",
    "tests/**/*",
    "__tests__/**/*.ts",
    "jest.setup.ts",
    "jest.setup.unit.ts",
    "jest.config.mjs",
    "scripts/**/*.cjs"
  ],
  "exclude": ["node_modules", "dist"]
}

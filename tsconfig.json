{
  "extends": "@tsconfig/node18/tsconfig.json",
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "rootDir": ".",
    "moduleResolution": "node",
    "baseUrl": "src",
    "paths": {
      "@/*": ["./*"],
      "@utils/*": ["./utils/*"],
      "@config/*": ["./config/*"],
      "@models/*": ["./models/*"],
      "@controllers/*": ["./controllers/*"],
      "@middleware/*": ["./middleware/*"]
    },
    "typeRoots": [
      "./node_modules/@types",
      "./src/types"
    ],
    "types": [
      "node",
      "jest"
    ],
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "declaration": false,
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true
  },
  "ts-node": {
    "compilerOptions": {
      "module": "NodeNext"
    }
  },
  "include": ["*.ts", "src/**/*", "tests/**/*", "__tests__/**/*.ts", "jest.setup.ts", "jest.config.mjs", "scripts/**/*.cjs"],
  "exclude": ["node_modules", "dist"]
}

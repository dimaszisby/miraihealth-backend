{
  "info": {
    "name": "Lakira Metrics Contract",
    "_postman_id": "1b3cbe7d-5235-41ec-a49d-metrics",
    "description": "Happy-path coverage for core metrics endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET /metrics – cursor listing",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{contractAuthToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/metrics?limit=10&sort=-createdAt",
          "host": ["{{baseUrl}}"],
          "path": ["metrics"],
          "query": [
            { "key": "limit", "value": "10" },
            { "key": "sort", "value": "-createdAt" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test(\"Envelope success\", function () {",
              "  pm.expect(json.status).to.eql(\"success\");",
              "  pm.expect(json.data.items).to.be.an(\"array\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /metrics – unauthorized",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/metrics?limit=5",
          "host": ["{{baseUrl}}"],
          "path": ["metrics"],
          "query": [{ "key": "limit", "value": "5" }]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 401\", function () {",
              "  pm.response.to.have.status(401);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "POST /metrics – create metric",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{contractAuthToken}}",
            "type": "text"
          },
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Contract Metric {{$randomInt}}\",\n  \"description\": \"Contract test metric\",\n  \"defaultUnit\": \"count\",\n  \"categoryId\": \"{{categoryRevenueId}}\",\n  \"isPublic\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/metrics",
          "host": ["{{baseUrl}}"],
          "path": ["metrics"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "const json = pm.response.json();",
              "pm.test(\"Metric payload returned\", function () {",
              "  pm.expect(json.data).to.have.property(\"id\");",
              "  pm.expect(json.data.categoryId).to.eql(pm.environment.get(\"categoryRevenueId\"));",
              "});",
              "pm.environment.set(\"contractCreatedMetricId\", json.data.id);",
              "pm.environment.set(\"contractCreatedMetricName\", json.data.name);"
            ]
          }
        }
      ]
    },
    {
      "name": "POST /metrics – validation error (missing name)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{contractAuthToken}}",
            "type": "text"
          },
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"invalid payload\",\n  \"defaultUnit\": \"count\",\n  \"categoryId\": \"{{categoryRevenueId}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/metrics",
          "host": ["{{baseUrl}}"],
          "path": ["metrics"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 400\", function () {",
              "  pm.response.to.have.status(400);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /metrics/:id – seeded metric detail",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{contractAuthToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/metrics/{{metricRevenueId}}",
          "host": ["{{baseUrl}}"],
          "path": ["metrics", "{{metricRevenueId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test(\"Metric id matches\", function () {",
              "  pm.expect(json.data.id).to.eql(pm.environment.get(\"metricRevenueId\"));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /metrics/:id – not found",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{contractAuthToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/metrics/00000000-0000-4000-8000-000000000088",
          "host": ["{{baseUrl}}"],
          "path": ["metrics", "00000000-0000-4000-8000-000000000088"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 404\", function () {",
              "  pm.response.to.have.status(404);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "PUT /metrics/:id – update created metric",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.environment.get('contractCreatedMetricId')) {",
              "  throw new Error('contractCreatedMetricId not set. Run the create metric request first.');",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test(\"Metric updated\", function () {",
              "  pm.expect(json.data.name).to.contain(\"Updated\");",
              "});",
              "pm.environment.set(\"contractCreatedMetricName\", json.data.name);"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{contractAuthToken}}",
            "type": "text"
          },
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{contractCreatedMetricName}} Updated\",\n  \"description\": \"Updated via contract test\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/metrics/{{contractCreatedMetricId}}",
          "host": ["{{baseUrl}}"],
          "path": ["metrics", "{{contractCreatedMetricId}}"]
        }
      }
    },
    {
      "name": "GET /metrics/:metricId/trends – seeded metric trend",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{contractAuthToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/metrics/{{metricRevenueId}}/trends",
          "host": ["{{baseUrl}}"],
          "path": ["metrics", "{{metricRevenueId}}", "trends"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test(\"Trend is array\", function () {",
              "  pm.expect(json.data).to.be.an(\"array\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "DELETE /metrics/:id – cleanup created metric",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.environment.get('contractCreatedMetricId')) {",
              "  throw new Error('contractCreatedMetricId not set. Run the create metric request first.');",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.environment.unset(\"contractCreatedMetricId\");",
              "pm.environment.unset(\"contractCreatedMetricName\");"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{contractAuthToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/metrics/{{contractCreatedMetricId}}",
          "host": ["{{baseUrl}}"],
          "path": ["metrics", "{{contractCreatedMetricId}}"]
        }
      }
    }
  ],
  "variable": [],
  "protocolProfileBehavior": {}
}

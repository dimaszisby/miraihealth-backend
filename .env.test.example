# Backend test environment template
NODE_ENV=test
PORT=8002

# JWT
JWT_SECRET=replace-with-test-secret

# Database
DB_NAME=lakira_test_db
DB_USER=lakira_user
DB_PASSWORD=lakira_password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_LOGGING=false
TEST_DATABASE_URL=postgres://lakira_user:lakira_password@127.0.0.1:5432/lakira_test_db

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_REQUIRED=true
ENABLE_REDIS_INTEGRATION=false

# CORS / misc
CORS_ORIGIN=http://localhost:3000


# RabbitMQ (disabled by default in test — enable for integration tests)                                            
RABBITMQ_ENABLED=false                                                                                                                                                   
RABBITMQ_HOST=127.0.0.1                                                                                            
RABBITMQ_PORT=5672                                                                                                                                                       
RABBITMQ_USER=guest                                                                                               
RABBITMQ_PASSWORD=guest                                                                                                                                                  
RABBITMQ_VHOST=/                                                                                                  
RABBITMQ_PREFETCH=10                                                                                        
RABBITMQ_MAX_RETRIES=5    